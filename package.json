{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "clean": "rm -rf .nuxt .output",
    "db:generate": "drizzle-kit generate --schema ./server/database/schema.ts --dialect sqlite --out ./server/database/migrations",
    "db:push": "drizzle-kit push --dialect sqlite --schema ./server/database/schema.ts --url ./local.db"
  },
  "dependencies": {
    "@fullcalendar/vue3": "^7.0.0",
    "@nuxt/ui": "^4.6.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.2",
    "temporal-polyfill": "^1.0.1"
  },
  "dependenciesMeta": {
    "@fullcalendar/vue3": {
      "injected": true
    }
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.102",
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.10"
  }
}
